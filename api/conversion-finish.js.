import crypto from "node:crypto";
import { neon } from "@neondatabase/serverless";

function parseCookies(req) {
const cookies = {};

for (const item of (req.headers.cookie || "").split(";")) {
const index = item.indexOf("=");

if (index < 0) continue;

const key = item.slice(0, index).trim();
const value = item.slice(index + 1).trim();

try {
  cookies[key] = decodeURIComponent(value);
} catch {
  cookies[key] = "";
}

}

return cookies;
}

function verifySession(req) {
const secret = process.env.SESSION_SECRET;

if (!secret) {
throw new Error("SESSION_SECRET belum dikonfigurasi.");
}

const token = parseCookies(req).zdc_session;

if (!token) return null;

const parts = token.split(".");

if (parts.length !== 2) return null;

const [payload, signature] = parts;

const expectedSignature = crypto
.createHmac("sha256", secret)
.update(payload)
.digest("base64url");

const received = Buffer.from(signature);
const expected = Buffer.from(expectedSignature);

if (
received.length !== expected.length ||
!crypto.timingSafeEqual(received, expected)
) {
return null;
}

try {
const user = JSON.parse(
Buffer.from(payload, "base64url").toString("utf8")
);

if (
  !user.id ||
  !/^\d+$/.test(user.id) ||
  !user.username ||
  !Number.isFinite(user.exp) ||
  user.exp <= Date.now()
) {
  return null;
}

return user;

} catch {
return null;
}
}

function parseIds(value) {
if (!value || value.trim().toLowerCase() === "none") {
return [];
}

return value
.split(",")
.map(id => id.trim())
.filter(id => /^\d+$/.test(id));
}

function getRole(userId) {
if (parseIds(process.env.ZDC_OWNER_IDS).includes(userId)) {
return "OWNER";
}

if (parseIds(process.env.ZDC_PREMIUM_IDS).includes(userId)) {
return "PREMIUM";
}

return "FREE";
}

export default async function handler(req, res) {
res.setHeader("Cache-Control", "no-store");

if (req.method !== "POST") {
res.setHeader("Allow", "POST");

return res.status(405).json({
  ok: false,
  message: "Metode tidak diizinkan."
});

}

let user;

try {
user = verifySession(req);
} catch (error) {
console.error("Conversion finish session error:", error.message);

return res.status(500).json({
  ok: false,
  message: "Konfigurasi sesi belum tersedia."
});

}

if (!user) {
return res.status(401).json({
ok: false,
message: "Silakan login melalui Discord terlebih dahulu."
});
}

const conversionId = req.body?.conversionId;

if (
!(
typeof conversionId === "string" &&
/^\d+$/.test(conversionId)
) &&
!(
typeof conversionId === "number" &&
Number.isSafeInteger(conversionId) &&
conversionId > 0
)
) {
return res.status(400).json({
ok: false,
message: "ID konversi tidak valid."
});
}

if (!process.env.DATABASE_URL) {
return res.status(500).json({
ok: false,
message: "Database belum dikonfigurasi."
});
}

try {
const sql = neon(process.env.DATABASE_URL);
const role = getRole(user.id);

/*
 * Endpoint ini hanya menangani kegagalan.
 * Status berhasil harus ditetapkan oleh alur server
 * setelah integrasi unggah Roblox tersedia.
 *
 * CTE memastikan riwayat berubah dari processing ke failed
 * hanya sekali. Pengembalian kuota hanya dilakukan jika
 * perubahan status tersebut berhasil.
 */
const rows = await sql`
  WITH failed AS (
    UPDATE conversion_history
    SET status = 'failed'
    WHERE id = ${String(conversionId)}::bigint
      AND discord_id = ${user.id}
      AND status = 'processing'
      AND expires_at > NOW()
    RETURNING id, created_at
  ),
  refunded AS (
    UPDATE daily_usage AS usage
    SET
      usage_count = usage.usage_count - 1,
      updated_at = NOW()
    FROM failed
    WHERE usage.discord_id = ${user.id}
      AND usage.usage_date =
        (failed.created_at AT TIME ZONE 'Asia/Jakarta')::date
      AND usage.usage_count > 0
      AND ${role === "FREE"}
    RETURNING usage.usage_count
  )
  SELECT
    failed.id,
    refunded.usage_count
  FROM failed
  LEFT JOIN refunded ON TRUE
`;

if (rows.length === 0) {
  return res.status(409).json({
    ok: false,
    message:
      "Konversi tidak ditemukan, sudah selesai, atau sudah kedaluwarsa."
  });
}

return res.status(200).json({
  ok: true,
  conversionId: String(rows[0].id),
  status: "failed",
  quotaRefunded:
    role === "FREE" && rows[0].usage_count !== null,
  message:
    role === "FREE" && rows[0].usage_count !== null
      ? "Kegagalan tercatat dan kuota dikembalikan."
      : "Kegagalan konversi berhasil dicatat."
});

} catch (error) {
console.error("Conversion finish error:", error.message);

return res.status(500).json({
  ok: false,
  message: "Gagal memperbarui status konversi."
});

}
}
